# Backend runtime configuration. Copy this file to backend/.env.
# Never commit backend/.env.

NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# Database: cloud for MongoDB Atlas, local for a host/local database.
DB_SOURCE=cloud
MONGODB_URI_CLOUD=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=quick-mail
MONGODB_URI_LOCAL=mongodb://localhost:27017/mern_smtp

# Gmail SMTP. Use a Google App Password, not the account password.
GMAIL_USER=<gmail-address>
GMAIL_APP_PASSWORD=<gmail-app-password>
MAIL_FROM_NAME=Quick Mail
MAIL_REPLY_TO=<gmail-address>

