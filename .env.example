# Docker Compose Environment Variables
# This file provides variable substitution for docker-compose.yml
# 
# IMPORTANT: Copy this file to .env and fill in your actual credentials
# cp .env.example .env

# Gmail SMTP Configuration
# Get app password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Database selection
DB_SOURCE=cloud
MONGODB_URI_CLOUD=mongodb+srv://user:password@cluster.example/mern_smtp

# Frontend API URL (used during Docker build)
# For production deployment, change this to your actual domain
# Example: VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Authentication
# Use a long random value in every deployed environment. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
EMAIL_RETENTION_DAYS=90

# Redis/BullMQ email delivery
REDIS_URL=redis://redis:6379
EMAIL_QUEUE_NAME=email-delivery
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=5000

# Browser session cookie settings
# Use "lax" for same-site deployments; use "none" only with HTTPS cross-site frontend/API.
COOKIE_SAME_SITE=lax
# Public frontend URL used in verification and password reset links
CLIENT_URL=http://localhost:3000
