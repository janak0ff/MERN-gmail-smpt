# Root Compose variables. Copy to .env for Docker Compose substitution.
# Runtime secrets belong in backend/.env, not in Vite/frontend variables.

# Database mode used by docker-compose.yml:
# cloud = MongoDB Atlas (default for deployment)
# local = the optional MongoDB container
DB_SOURCE=cloud

# Used only when building the frontend outside Docker.
VITE_API_URL=http://localhost:5000/api
